# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYMENT PROVIDERS (Optional - leave blank to use the built-in Sandbox Payment Simulator)
# Stripe Connect Express secret key for international escrow and payouts (USD, EUR, GBP, SGD)
STRIPE_SECRET_KEY=""

# Regional licensed Payment Service Provider key (e.g., Midtrans or Xendit for IDR escrow)
REGIONAL_PSP_PROVIDER="midtrans"
REGIONAL_PSP_KEY=""
